{
  "expo": {
    "name": "客户关系管理-大卫创业导师",
    "slug": "sales-crm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-brand.png",
    "userInterfaceStyle": "light",
    "scheme": "sales-crm",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.salescrm.app"
    },
    "android": {
      "package": "com.salescrm.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F3EA",
        "foregroundImage": "./assets/app-icon-brand.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "需要访问位置信息以记录拜访地点",
          "locationWhenInUsePermission": "需要访问位置信息以记录拜访地点"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "需要访问麦克风以使用语音录入客户、跟踪、销售和任务。"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F3EA",
          "image": "./assets/splash-brand.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bfbab511-a237-433f-a275-43a9caf064c1"
      }
    },
    "owner": "highway5673"
  }
}
